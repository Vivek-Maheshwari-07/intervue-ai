# ==============================================================================
# Intervue AI — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Public base URL of the FastAPI backend service
# Local Development: http://localhost:8000
# Production (Vercel): https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Comma-separated allowed origins for CORS (or '*' for unrestricted in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SQLite database file path
INTERVIEW_DB_PATH=backend/interview_sessions.db

# Server port (set automatically by cloud hosting providers like Render)
PORT=8000

# ------------------------------------------------------------------------------
# AI Model / Ollama Configuration
# ------------------------------------------------------------------------------
# Base URL for the Ollama inference server:
# - Local Dev: http://localhost:11434
# - Production (Render): Set to your remote GPU Ollama server or tunnel URL 
#   (e.g., https://xxxx.ngrok-free.app or Modal GPU host endpoint).
# - NOTE: Render container cannot access your personal laptop's localhost:11434.
#   If OLLAMA_BASE_URL is unreachable/times out, backend automatically uses its
#   built-in deterministic answer-differentiated fallback engine with 100% uptime.
OLLAMA_BASE_URL=http://localhost:11434

# Target Ollama model tag
OLLAMA_MODEL=qwen3:8b

# Timeout in seconds before falling back to deterministic answer engine (default: 3s)
OLLAMA_TIMEOUT=3
