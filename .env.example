# ==============================================================================
# Intervue AI — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Public base URL of the FastAPI backend service
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Comma-separated allowed origins for CORS (or '*' for unrestricted)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SQLite database file path
INTERVIEW_DB_PATH=backend/interview_sessions.db

# Server port (set automatically by hosting providers like Render)
PORT=8000

# ------------------------------------------------------------------------------
# AI Model / Ollama Configuration
# ------------------------------------------------------------------------------
# Base URL for the Ollama inference server (local or remote cloud host)
OLLAMA_BASE_URL=http://localhost:11434

# Target Ollama model tag
OLLAMA_MODEL=qwen3:8b

# Timeout in seconds before falling back to deterministic answer engine
OLLAMA_TIMEOUT=3
